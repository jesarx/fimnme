# FIMNME — configuración de fimnme-web.
# Se instala como /etc/fimnme/fimnme-web.env y la lee systemd (EnvironmentFile).
# Tras editarla:  sudo systemctl restart fimnme-web
#
# Aquí NO van secretos por ahora. Cuando los haya (SMTP, HMAC del espejo) este
# archivo debe conservar permisos 0640 root:fimnme.

# Dirección en la que escucha. Debe ser 127.0.0.1: el servicio va SIEMPRE
# detrás del proxy inverso con TLS y nunca se expone directo a Internet.
FIMNME_SERVE=127.0.0.1

# Puerto local. Debe coincidir con el configurado en Caddy o nginx.
FIMNME_PORT=8080

# desarrollo: muestra la franja de advertencia y pide a los buscadores no indexar.
# produccion: sin franja.
FIMNME_ENTORNO=desarrollo
