# FIMNME — configuración de fimnme-web.
# Se instala como /etc/fimnme/fimnme-web.env y la lee systemd (EnvironmentFile).
# Tras editarla:  sudo systemctl restart fimnme-web
#
# Aquí NO van secretos por ahora. Cuando los haya (SMTP, HMAC del espejo) este
# archivo debe conservar permisos 0640 root:fimnme.

# Dirección en la que escucha. Debe ser 127.0.0.1: el servicio va SIEMPRE
# detrás del proxy inverso con TLS y nunca se expone directo a Internet.
FIMNME_SERVE=127.0.0.1

# Puerto local. Debe coincidir con el configurado en Caddy o nginx.
FIMNME_PORT=8080

# desarrollo: muestra la franja de advertencia y pide a los buscadores no indexar.
# produccion: sin franja.
FIMNME_ENTORNO=desarrollo

# Directorio de datos: base SQLite (fimnme.db) y acervo de archivos. Debe
# pertenecer al usuario «fimnme». La unidad de systemd ya usa este valor.
FIMNME_DATOS=/var/lib/fimnme

# Dirección pública del sitio, sin barra final. Con ella se arman los enlaces
# de los correos (verificación, recuperación, activación). En el entorno de
# producción el servicio no arranca si falta.
FIMNME_URL_BASE=https://dev.fimnme.example

# Máximo de correos que se envían por minuto. Las ráfagas disparan los filtros
# de correo no deseado de los grandes proveedores.
FIMNME_CORREO_POR_MINUTO=30

# Espacio libre mínimo del disco de datos, en GB. Por debajo, el servicio lo
# registra como error y avisa por correo a los administradores una vez al día.
# Con 0 no se vigila.
FIMNME_DISCO_MIN_GB=10

# Correo (ADR 0025). Elija UNA de las tres configuraciones.
#
# 1. Servidor que no puede enviar correo (puerto 25 bloqueado): cada mensaje
#    queda completo como .eml en /var/lib/fimnme/correo, sin enviarse.
FIMNME_CORREO=archivo
FIMNME_REMITENTE=FIMNME <no-responder@postula.ejemplo.mx>
#
# 2. Relevo externo por el puerto de envío (587). La contraseña, SÓLO aquí.
#FIMNME_CORREO=smtp
#FIMNME_SMTP_SERVIDOR=smtp.proveedor.com:587
#FIMNME_SMTP_SEGURIDAD=starttls
#FIMNME_SMTP_USUARIO=usuario
#FIMNME_SMTP_PASSWORD=contraseña
#
# 3. Instalación final: Postfix local con DKIM, que entrega a Internet. Se
#    instala con /opt/fimnme/correo/instalar_correo.sh (ADR 0030).
#FIMNME_CORREO=smtp
#FIMNME_SMTP_SERVIDOR=127.0.0.1:25
#FIMNME_SMTP_SEGURIDAD=ninguno
