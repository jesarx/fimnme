# FIMNME — unidad de systemd del servidor web (fimnme-web).
# Software libre bajo la licencia GNU GPL v3.0; véase el archivo LICENSE.
#
# Instalación: la copian deploy/instalar_vps.sh y deploy/actualizar_vps.sh en
# /etc/systemd/system/.
# Consulta de logs:  journalctl -u fimnme-web -f

[Unit]
Description=FIMNME - servidor web de la plataforma de postulaciones
Documentation=https://github.com/jesarx/fimnme
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fimnme
Group=fimnme

# Directorio de datos. Se fija aquí para que el servicio funcione aunque el
# archivo de configuración no lo mencione; ese archivo puede sobrescribirlo.
Environment=FIMNME_DATOS=/var/lib/fimnme
WorkingDirectory=/var/lib/fimnme

# Configuración (IP, puerto, entorno). El guion inicial "-" permite arrancar
# con los valores por omisión si el archivo no existe.
EnvironmentFile=-/etc/fimnme/fimnme-web.env
ExecStart=/opt/fimnme/bin/fimnme-web

# Si el proceso cae, systemd lo levanta de nuevo.
Restart=on-failure
RestartSec=3
# Margen para terminar las peticiones en curso (el binario espera hasta 15 s).
TimeoutStopSec=20

# Directorio de datos: /var/lib/fimnme, con dueño fimnme. Contiene la base
# SQLite (fimnme.db y sus archivos -wal y -shm) y, más adelante, el acervo de
# archivos. Es lo único del sistema de archivos que el servicio puede escribir.
StateDirectory=fimnme
StateDirectoryMode=0750

# --- Endurecimiento: el servicio es público y corre con lo mínimo ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027

[Install]
WantedBy=multi-user.target
