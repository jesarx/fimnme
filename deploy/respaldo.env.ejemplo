# FIMNME — configuración del respaldo automatizado (/etc/fimnme/respaldo.env).
# Software libre bajo la licencia GNU GPL v3.0; véase el archivo LICENSE.

# Dónde quedan las instantáneas y la copia del acervo. Mejor en otro disco.
FIMNME_RESPALDO_DESTINO=/var/backups/fimnme

# Clave de firma de las instantáneas. NUNCA junto a las instantáneas ni en el
# remoto: el espejo recibe su copia por un canal seguro, una sola vez.
FIMNME_RESPALDO_CLAVE=/etc/fimnme/espejo.clave

# Días que se conservan las instantáneas.
FIMNME_RESPALDO_CONSERVAR_DIAS=90

# Copia a otro servidor por rsync sobre SSH (usuario@host:/ruta). Vacío: sólo
# local. El usuario fimnme necesita una llave SSH sin frase autorizada en el
# remoto (véase README, «Respaldos automatizados»).
FIMNME_RESPALDO_REMOTO=
